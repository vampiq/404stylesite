# ── Приложение ─────────────────────────────
NODE_ENV=development
PORT=4000
SITE_URL=http://localhost:5173          # для sitemap.xml и canonical
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173      # whitelist через запятую

# ── База данных ────────────────────────────
# SQLite (dev):
DATABASE_URL="file:./dev.db"
# PostgreSQL (prod), также смени provider в prisma/schema.prisma:
# DATABASE_URL="postgresql://user:pass@localhost:5432/404style?schema=public"

# ── Аутентификация ─────────────────────────
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# ── Cookies / CSRF ─────────────────────────
COOKIE_DOMAIN=
COOKIE_SECURE=false                     # true на https
COOKIE_SAMESITE=lax                     # none, если фронт и API на разных доменах (+ secure)

# ── Rate limiting ──────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ── Seed ───────────────────────────────────
SEED_PASSWORD=password123

# ── Frontend (Vite) ────────────────────────
VITE_API_URL=/api                       # в dev проксируется на PORT
